{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "tsb-kasko-mcp",
  "build": {
    "context": "..",
    "dockerfile": "../.docker/python/Dockerfile",
    "target": "builder"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/tsb-kasko-mcp",
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/workspaces/tsb-kasko-mcp/.venv",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "uv sync --all-extras --all-groups && uv run pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "editorconfig.editorconfig",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/tsb-kasko-mcp/.venv/bin/python",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
        }
      }
    }
  }
}
