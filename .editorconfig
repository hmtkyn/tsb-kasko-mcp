# EditorConfig keeps indentation, encoding and line endings identical no matter
# which editor or operating system a contributor works on. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so leave them alone.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
# Windows shells parse these reliably only with CRLF.
end_of_line = crlf

[Makefile]
indent_style = tab

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

[LICENSE]
insert_final_newline = true
